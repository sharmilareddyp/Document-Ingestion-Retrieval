# Copy to .env. Values below are local defaults, not production secrets.

DATABASE_URL=postgresql+psycopg://ingestion:ingestion@localhost:5432/ingestion
PINECONE_API_KEY=
PINECONE_INDEX_NAME=documents
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BACKEND=fake
VECTOR_BACKEND=fake
VECTOR_STORE_PATH=./data/vector_store.json

LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25
ALLOWED_SOURCE_HOSTS=localhost,127.0.0.1,sample-api
ALLOWED_FILE_ROOTS=./sample_data,./data
ALLOW_PRIVATE_SOURCE_HOSTS=true

API_AUTH_ENABLED=false
API_KEYS=

AIRFLOW_FERNET_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
AIRFLOW_SECRET_KEY=local-dev-webserver-secret
INGESTION_CRON=0 * * * *
API_SYNC_CRON=15 * * * *
QUALITY_CRON=30 * * * *
DRIFT_CRON=45 * * * *
RECONCILIATION_CRON=*/15 * * * *

SAMPLE_API_TOKEN=
